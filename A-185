local function Jumpscare()
	local Players = game:GetService("Players")
	local TweenService = game:GetService("TweenService")

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local rng = Random.new()

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "JumpscareGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.Parent = playerGui

	-- Tạo background
	local background = Instance.new("Frame")
	background.Name = "Background"
	background.Size = UDim2.fromScale(1, 1)
	background.Position = UDim2.fromScale(0, 0)
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BorderSizePixel = 0
	background.Parent = screenGui

	local imageLabel = Instance.new("ImageLabel")
	imageLabel.Name = "ImageLabel"
	imageLabel.BackgroundTransparency = 1
	imageLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	imageLabel.Position = UDim2.fromScale(0.5, 0.5)
	imageLabel.Size = UDim2.new(0, 0.001, 0, 0.001)
	imageLabel.Image = "rbxassetid://15534432648"
	imageLabel.Parent = background

	local jumpscareSound = Instance.new("Sound")
	jumpscareSound.Name = "Jumpscare"
	jumpscareSound.SoundId = "rbxassetid://298553078"
	jumpscareSound.Volume = 10
	jumpscareSound.PlaybackSpeed = 4
	jumpscareSound.Parent = workspace

	local dis = Instance.new("DistortionSoundEffect")
	dis.Level = 0.75
	dis.Enabled = true
	dis.Parent = jumpscareSound

	local pitch = Instance.new("PitchShiftSoundEffect")
	pitch.Octave = 0.545
	pitch.Enabled = true
	pitch.Parent = jumpscareSound

	local echo = Instance.new("EchoSoundEffect")
	echo.Delay = 0.02
	echo.Feedback = 0.93
	echo.Enabled = true
	echo.Parent = jumpscareSound

	jumpscareSound:Play()

	local fullTween = TweenService:Create(
		imageLabel,
		TweenInfo.new(0.7, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{
			Size = UDim2.new(0, 1250, 0, 1250)
		}
	)

	fullTween:Play()

	for i = 1, 70 do
		local mode = rng:NextInteger(1, 3)

		if mode == 1 then
			background.BackgroundColor3 = Color3.new(0.333333, 0.666667, 1)
			imageLabel.ImageColor3 = Color3.new(0, 1, 1)
			imageLabel.Position = UDim2.new(rng:NextNumber(0.4, 0.6), 0, rng:NextNumber(0.4, 0.6), 0)
		elseif mode == 2 then
			background.BackgroundColor3 = Color3.new(0.333333, 1, 1)
			imageLabel.ImageColor3 = Color3.new(0, 0, 0)
			imageLabel.Position = UDim2.new(rng:NextNumber(0.4, 0.6), 0, rng:NextNumber(0.4, 0.6), 0)
		else
			background.BackgroundColor3 = Color3.new(0, 0, 0)
			imageLabel.ImageColor3 = Color3.new(0, 1, 1)
			imageLabel.Position = UDim2.new(rng:NextNumber(0.4, 0.6), 0, rng:NextNumber(0.4, 0.6), 0)
		end

		imageLabel.Rotation = rng:NextInteger(-10, 10)
		task.wait(0.00001)
	end


	screenGui:Destroy()
	imageLabel:Destroy()
	background:Destroy()
end

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
	if firstTime == true then
		print("Entity has entered room: ".. room.Name.. " for the first time")
		local entity5 = entity.Model
		if not entity5 or not firstTime then return end

		task.spawn(function()
			task.wait(0.1)
			local wardrobes = {}

			for _, v in ipairs(room:GetDescendants()) do
				if v:IsA("Model") then
					local n = string.lower(v.Name)
					if n:find("wardrobe") or n:find("closet") then
						table.insert(wardrobes, v)
					end
				end
			end

			table.sort(wardrobes, function(a, b)
				return a:GetPivot().Position.X < b:GetPivot().Position.X
			end)

			local player = game.Players.LocalPlayer
			local char = player.Character

			for _, wardrobe in ipairs(wardrobes) do
				entity:Pause()
				entity5:PivotTo(wardrobe:GetPivot() * CFrame.new(0, 0, -7))
				task.wait(0.35)

				local function isPlayerInsideWardrobe()
					if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
					local boxPos = wardrobe:GetPivot().Position
					return (char.HumanoidRootPart.Position - boxPos).Magnitude < 6
				end

				local wasHiding = isPlayerInsideWardrobe()
				task.wait(1.5)

				-- Destroy Doors + Prompts
				for _, v in ipairs(wardrobe:GetDescendants()) do
					if v:IsA("ProximityPrompt") or v.Name == "HidePrompt" then v:Destroy()
					end
				end

				-- KILL + JUMPSCARE
				if isPlayerInsideWardrobe() or wasHiding then
					if char then
						task.spawn(Jumpscare) 
						task.wait(0.1)
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then hum.Health = 0 end
					end
				end

				entity:Resume()
				task.wait(0.2)
			end
		end)
	else
		print("Entity has entered room: ".. room.Name.. " again")
	end
end)

