local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- \\ Variables // --

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local Modules = {
	AchievementUnlock = require(PlayerGui:FindFirstChild("AchievementUnlock", true) :: ModuleScript),
	Achievements = require(ReplicatedStorage.ModulesShared.Achievements :: ModuleScript)
}
local DefaultAchievement = {
	Identifier = "TestAchievement",
	Title = "Title",
	Desc = "Description",
	Reason = "Reason",
	Image = "rbxassetid://12309073114"
}
local DefaultOptions = {
	CheckOwned = false,
	Remember = true
}

local Module = {}

type AchievementConfig = {
	Identifier: string?,
	Title: string?,
	Desc: string?,
	Reason: string?,
	Image: string?
}

type Achievement = {
	Title: string,
	Desc: string,
	Reason: string,
	Image: string,
	GetInfo: (self: Achievement) -> Achievement,
	[string]: any
}

type Options = {
	CheckOwned: boolean,
	Remember: boolean
}

type OwnedAchievements = { string }

-- \\ Functions // --

local function WriteConfig(data: OwnedAchievements): (boolean, string?)
	return pcall(function()
		writefile("DOORS_Custom_Achievements.json", HttpService:JSONEncode(data))
	end)
end

local function DecodeConfig(): OwnedAchievements
	local success, result = pcall(function()
		return HttpService:JSONDecode(readfile("DOORS_Custom_Achievements.json"))
	end)
	return success and result or {}
end

-- Bộ ký tự Glitch
local GLITCH_CHARS = "[]{}0(0*#21!@#$%^&*()_+-=/<>?:;10"

local function GenerateGlitchText(length: number): string
	local str = table.create(length)
	for i = 1, length do
		local r = math.random(1, #GLITCH_CHARS)
		str[i] = string.sub(GLITCH_CHARS, r, r)
	end
	return table.concat(str)
end

-- Hiệu ứng Glitch đen che chữ mượt không gây lag
local function ApplyGlitchEffect(frame, originalTitle, originalDesc)
	task.spawn(function()
		local titleLabel, descLabel

		for _, obj in ipairs(frame:GetDescendants()) do
			if obj:IsA("TextLabel") then
				if obj.Text == originalTitle then
					titleLabel = obj
				elseif obj.Text == originalDesc then
					descLabel = obj
				end
			end
		end

		local overlay = Instance.new("Frame")
		overlay.Name = "GlitchOverlay"
		overlay.Size = UDim2.new(1, 0, 1, 0)
		overlay.BackgroundTransparency = 1
		overlay.ZIndex = 999
		overlay.Parent = frame

		-- Tạo sẵn 4 thanh vạch đen (Tái sử dụng Frame)
		local bars = {}
		for i = 1, 4 do
			local b = Instance.new("Frame")
			b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			b.BorderSizePixel = 0
			b.ZIndex = 1000
			b.Visible = false
			b.Parent = overlay
			table.insert(bars, b)
		end

		-- Chạy hiệu ứng nhấp nháy 8 lần (khoảng 0.4s)
		for i = 1, 8 do
			for _, b in ipairs(bars) do
				if math.random() > 0.35 then
					b.Size = UDim2.new(math.random(20, 85) / 100, 0, math.random(10, 30) / 100, 0)
					b.Position = UDim2.new(math.random(5, 45) / 100, 0, math.random(10, 75) / 100, 0)
					b.Visible = true
				else
					b.Visible = false
				end
			end

			if titleLabel then titleLabel.Text = GenerateGlitchText(#originalTitle) end
			if descLabel then descLabel.Text = GenerateGlitchText(#originalDesc) end

			task.wait(0.05)
		end

		-- Trả về chữ gốc và xóa overlay
		if titleLabel then titleLabel.Text = originalTitle end
		if descLabel then descLabel.Text = originalDesc end
		overlay:Destroy()
	end)
end

Module.CheckOwned = function(self, identifier: string): boolean
	return table.find(DecodeConfig(), identifier) ~= nil
end

Module.Revoke = function(self, identifier: string)
	local config = DecodeConfig()

	for i, v in next, config do
		if v == identifier then
			table.remove(config, i)
		end
	end

	WriteConfig(config)
end

Module.Grant = function(self, achievementConfig: AchievementConfig, options: Options?)
	options = typeof(options) == "table" and options or DefaultOptions

	local config = DecodeConfig()

	local achievement = {}
	if typeof(achievementConfig) == "table" then
		for i, v in next, achievementConfig do
			achievement[i] = v
		end
	end
	for i, v in next, DefaultAchievement do
		if achievement[i] == nil then
			achievement[i] = v
		end
	end

	if
		options.CheckOwned
		and table.find(config, achievementConfig.Identifier)
	then
		return
	end

	achievement.GetInfo = function(self: Achievement): Achievement
		return self
	end

	task.defer(function()
		local name = "CustomAchievement_"..tick()
		Modules.Achievements[name] = achievement

		local connection
		-- Nhận diện cực nhanh bằng cách lọc đúng TextLabel của Title
		connection = PlayerGui.DescendantAdded:Connect(function(desc)
			if desc:IsA("TextLabel") and desc.Text == achievement.Title then
				-- Ngắt kết nối ngay lập tức để không quét UI khác (Triệt hạ lag)
				if connection then
					connection:Disconnect()
					connection = nil
				end

				local mainFrame = desc:FindFirstAncestorOfClass("Frame") or desc:FindFirstAncestorOfClass("CanvasGroup")
				if not mainFrame then return end

				task.wait(0.02)

				-- ĐỔI MÀU ĐỎ VIỀN VÀ CHỮ
				for _, item in ipairs(mainFrame:GetDescendants()) do
					if item:IsA("UIStroke") then
						item.Color = Color3.fromRGB(255, 0, 0)
					elseif item:IsA("TextLabel") then
						local txt = item.Text:lower()
						if txt:find("unlock") or txt:find("achievement") or item == desc then
							item.TextColor3 = Color3.fromRGB(255, 0, 0)
						end
					end
				end

				-- KÍCH HOẠT HIỆU ỨNG GLITCH ĐEN CHE CHỮ
				ApplyGlitchEffect(mainFrame, achievement.Title, achievement.Desc)
			end
		end)

		Modules:AchievementUnlock(name)
		Modules.Achievements[name] = nil

		task.delay(3, function()
			if connection then
				connection:Disconnect()
			end
		end)
	end)

	if
		options.Remember
		and not self:CheckOwned(achievementConfig.Identifier)
	then
		config[#config + 1] = achievementConfig.Identifier
		WriteConfig(config)
	end
end

return Module
